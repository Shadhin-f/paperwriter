# Optional settings. Copy to .env (git-ignored) and fill in what you need.

# Port to listen on
PORT=5178

# Interface to bind. Leave unset and use the "Devices on my network" switch in the Share dialog instead.
# 127.0.0.1 = only this computer, 0.0.0.0 = also other devices on your network.
# HOST=127.0.0.1

# AI keys (alternatively, enter them in Settings; they're stored in .data/settings.json)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
