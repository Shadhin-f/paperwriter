# Copy this file to .env (local) or add the same variables in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run single-user, with projects saved as files on this computer.

# ── Cloud mode: sign-in, sharing, email invites, live co-editing ──
# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=
# The "anon public" or "publishable" key. Safe to expose to browsers.
SUPABASE_ANON_KEY=
# Optional, server-only: the "service_role" or "secret" key. Never commit it or expose it in the browser.
# Lets brand-new people receive a proper "You've been invited" email
# (without it they get a magic sign-in link instead).
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional shared AI keys, used by everyone signed in to your deployment ──
# Leave empty if each person should paste their own key in Settings (kept in their browser).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: public URL used in invite emails (defaults to the address the request came from)
APP_URL=
