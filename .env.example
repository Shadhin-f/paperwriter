# Optional settings. Copy to .env (git-ignored) and fill in what you need.
# Most people never need this file: the setup guide in the browser covers everything.

# Port to listen on
PORT=5178

# Interface to bind. Leave unset and use the "Devices on my network" switch in the Share dialog instead.
# 127.0.0.1 = only this computer, 0.0.0.0 = also other devices on your network.
# HOST=127.0.0.1

# ── Hosting on a server (docker compose) ──
# Your domain, already pointing at this server. Caddy gets an HTTPS certificate for it automatically.
# DOMAIN=papers.example.org
# The address collaborators use, if it isn't https://DOMAIN (e.g. behind your own proxy).
# PUBLIC_URL=https://papers.example.org
# Set when PaperWriter runs behind a reverse proxy, so sign-in limits apply per visitor.
# TRUST_PROXY=1

# AI keys (alternatively, enter them in Settings; they're stored in .data/settings.json)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
